{
  "name": "mrvc",
  "displayName": "MRVC",
  "description": "MRVC — open, configure and build MounRiver (MRS) projects for WCH MCUs directly in VSCode.",
  "version": "0.1.7",
  "publisher": "mrvc",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartmx/MRVC.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "WCH",
    "MounRiver",
    "MRS",
    "RISC-V",
    "embedded",
    "CH32",
    "CH58x",
    "CH59x"
  ],
  "activationEvents": [
    "workspaceContains:**/.project",
    "workspaceContains:**/*.wvproj",
    "onCommand:mrvc.openProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "MRVC",
      "properties": {
        "mrvc.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "Follow the VSCode display language",
            "English",
            "简体中文（运行时消息、提示与树描述；命令标题保持英文）"
          ],
          "default": "auto",
          "description": "UI language for MRVC's runtime messages and prompts (command titles in the palette stay English). Takes effect after reload. / MRVC 运行时消息与提示的界面语言（命令面板标题保持英文），重新加载窗口后生效。",
          "order": 1
        },
        "mrvc.mrs2InstallPath": {
          "type": "string",
          "default": "C:\\MounRiver\\MounRiver_Studio2",
          "description": "MRS2 (MounRiver Studio 2) installation path. Provides the RISC-V toolchain, make, OpenOCD and WCH-LinkUtility used by this extension. Example: C:\\MounRiver\\MounRiver_Studio2",
          "order": 0
        },
        "mrvc.toolchain": {
          "type": "string",
          "enum": [
            "auto",
            "GCC8",
            "GCC12",
            "GCC15"
          ],
          "enumDescriptions": [
            "Follow the toolchain recorded in each project (.cproject rvGcc option / prefix)",
            "RISC-V Embedded GCC 8.2 (riscv-none-embed-)",
            "RISC-V Embedded GCC 12.2 (riscv-wch-elf-)",
            "RISC-V Embedded GCC 15.2 (riscv32-wch-elf-)"
          ],
          "default": "auto",
          "description": "Toolchain component used for building.",
          "order": 1
        },
        "mrvc.customToolchains": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name used to reference this toolchain (mrvc.toolchain / per-project override accept it)."
              },
              "path": {
                "type": "string",
                "description": "Toolchain root folder (the one containing bin/)."
              },
              "prefix": {
                "type": "string",
                "description": "Executable prefix, e.g. riscv-none-elf-. Detected from bin/ when omitted."
              }
            },
            "description": "Custom toolchain entry."
          },
          "description": "Custom (user-provided) toolchains. Reference by name via mrvc.toolchain — matching is case-insensitive. Custom entries win over the MRS2-installed ones with the same name; prefixes are auto-detected from bin/ when omitted.",
          "order": 1
        },
        "mrvc.build.analysis": {
          "type": "boolean",
          "default": false,
          "description": "Emit static-analysis data during builds (-fstack-usage .su files and -fdump-rtl-expand dumps into the build dir). Enables Static Stack Usage / Function Call Analysis after the next build.",
          "order": 2
        },
        "mrvc.build.parallelJobs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Number of parallel make jobs (-j). 0 = number of CPU cores.",
          "order": 2
        },
        "mrvc.build.verbose": {
          "type": "string",
          "enum": [
            "concise",
            "normal",
            "full"
          ],
          "enumDescriptions": [
            "Only errors/warnings",
            "Per-file compile lines (default)",
            "Echo every gcc command line"
          ],
          "default": "normal",
          "description": "Build output verbosity. 'full' passes VERBOSE=1 style echoing.",
          "order": 3
        },
        "mrvc.openocd.path": {
          "type": "string",
          "default": "",
          "description": "Override path of openocd.exe. Empty = use the one from the MounRiver installation.",
          "order": 4
        },
        "mrvc.openocd.config": {
          "type": "string",
          "default": "",
          "description": "Override OpenOCD config file for flashing (default: wch-riscv.cfg shipped with MounRiver).",
          "order": 5
        },
        "mrvc.flash.address": {
          "type": "string",
          "default": "",
          "description": "Flash start address override for OpenOCD 'program' (e.g. 0x00000000). Empty = use the address from the project's .template file, or infer it from the chip family (source file prefixes) when the template has none.",
          "order": 6
        },
        "mrvc.flash.verify": {
          "type": "boolean",
          "default": true,
          "description": "Verify flash after download.",
          "order": 7
        },
        "mrvc.flash.reset": {
          "type": "boolean",
          "default": true,
          "description": "Reset target after download.",
          "order": 8
        },
        "mrvc.solution": {
          "type": "string",
          "default": "",
          "markdownDescription": "Solution (`.wvsln`) this window was opened for. Managed by the extension: opening a `.wvsln` writes it into the generated `.code-workspace` so the solution reloads on activation. Do not edit manually — clear it (or use Close Solution) to detach the window from the solution."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mrvc-explorer",
          "title": "MRVC",
          "icon": "media/chip.svg"
        }
