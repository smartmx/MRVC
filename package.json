          "group": "mrvc@1"
        },
        {
          "command": "mrvc.cleanSolution",
          "when": "view == mrvc.projectExplorer && viewItem == solution",
          "group": "mrvc@2"
        },
        {
          "command": "mrvc.excludeFromBuild",
