          "when": "view == mrvc.projectExplorer",
          "group": "navigation@4"
        },
        {
          "command": "mrvc.buildAll",
          "when": "view == mrvc.projectExplorer && mrvc.hasProjects",
          "group": "1_build@1"
        },
        {
