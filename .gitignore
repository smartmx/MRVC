out/
node_modules/
# the FFI runtime must be tracked: re-include vendor-ffi/node_modules BEFORE
# the koffi subtree (git needs the un-ignored DIRECTORY to descend into it)
!vendor-ffi/node_modules/
!vendor-ffi/node_modules/koffi/
# the serialport runtime must be tracked too (SDI PRINT monitor, 0.3.0)
!vendor-serial/node_modules/
.scratch/
.mimosa/
buildlogs/
# never ignore the release artifact, even if a develop-side .gitignore
# (which has *.vsix) ever gets copied over this file wholesale
!mrvc-*.vsix
